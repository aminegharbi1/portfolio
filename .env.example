# ─── Database ────────────────────────────────────────────────────────────────
# Runtime connection. On Neon use the *pooled* connection string (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) connection, used by `prisma migrate`. Optional locally.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ─── Site ────────────────────────────────────────────────────────────────────
# Public base URL, used for sitemap, Open Graph and canonical links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Admin auth ────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
ADMIN_EMAIL="you@example.com"
# Generate with: npm run hash-password -- "your-password" (it prints the line to paste)
ADMIN_PASSWORD_HASH=""

# ─── Uploads ───────────────────────────────────────────────────────────────
# Created automatically when you connect a Vercel Blob store to the project.
# Leave empty locally: uploads are then saved in public/uploads.
BLOB_READ_WRITE_TOKEN=""
