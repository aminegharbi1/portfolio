// Portfolio content model. Every public section reads from these tables and
// every table is editable from /admin.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  DRAFT
  PUBLISHED
}

enum TimelineKind {
  EDUCATION
  EXPERIENCE
  PROJECT
  CERTIFICATION
}

/// Singleton row (id = 1) holding site-wide profile settings.
model Profile {
  id               Int       @id @default(1)
  name             String
  headline         String
  /// Hero headline. Wrap a word in *asterisks* to render it in the accent color.
  heroTitle        String
  intro            String
  /// Markdown.
  bio              String
  location         String
  available        Boolean   @default(true)
  availabilityText String
  email            String?
  githubUrl        String?
  linkedinUrl      String?
  accentColor      String    @default("#4C8DFF")
  photoUrl         String?
  cvUrl            String?
  cvUpdatedAt      DateTime?
  updatedAt        DateTime  @updatedAt
}

model Project {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  summary       String
  /// Markdown.
  description   String
  /// Markdown.
  problem       String?
  /// Markdown.
  solution      String?
  features      String[]
  /// Free text, e.g. "personal", "EMSI end-of-year project", "internship".
  context       String
  date          DateTime
  stack         String[]
  collaborators String[]
  coverUrl      String?
  coverAlt      String?
  repoUrl       String?
  demoUrl       String?
  featured      Boolean        @default(false)
  status        Status         @default(DRAFT)
  position      Int            @default(0)
  images        ProjectImage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, position])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  position  Int     @default(0)

  @@index([projectId, position])
}

model Experience {
  id         String    @id @default(cuid())
  role       String
  company    String
  location   String
  /// "on-site" | "remote" | "hybrid"
  workMode   String?
  startDate  DateTime
  endDate    DateTime?
  /// Markdown.
  summary    String
  highlights String[]
  stack      String[]
  status     Status    @default(PUBLISHED)
  position   Int       @default(0)

  @@index([status, position])
}

/// Entries of the "git log --me" timeline.
model TimelineEvent {
  id          String       @id @default(cuid())
  kind        TimelineKind
  title       String
  org         String?
  description String?
  date        DateTime
  /// Optional display override, e.g. "2023 – 2028".
  dateLabel   String?
  link        String?
  status      Status       @default(PUBLISHED)
  position    Int          @default(0)

  @@index([status, position])
}

/// One step of the Data → Model → API → Interface pipeline.
model SkillGroup {
  id          String  @id @default(cuid())
  title       String
  tagline     String?
  description String?
  status      Status  @default(PUBLISHED)
  position    Int     @default(0)
  skills      Skill[]

  @@index([status, position])
}

model Skill {
  id        String     @id @default(cuid())
  name      String
  groupId   String
  group     SkillGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inMarquee Boolean    @default(true)
  position  Int        @default(0)

  @@unique([groupId, name])
  @@index([groupId, position])
}

/// Question chips of the "ask-amine" terminal.
model Faq {
  id       String @id @default(cuid())
  question String
  answer   String
  /// Shown as "↳ source: …".
  source   String
  status   Status @default(PUBLISHED)
  position Int    @default(0)

  @@index([status, position])
}

/// Login attempts, used for rate limiting the admin login.
model LoginAttempt {
  id        String   @id @default(cuid())
  /// Hashed client IP.
  key       String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
